generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShipmentStatus {
  QUOTED
  PAID
  LABEL_CREATED
  FAILED
  REFUNDED
  RECHARGE_BLOCKED_BY_CARD_ISSUER
}

enum MarkupType {
  PERCENT
  FLAT
}

model Shipment {
  id                    String         @id @default(cuid())
  quoteGroupId          String
  customerEmail         String
  originAddress         Json
  destAddress           Json
  parcel                Json
  selectedCourierId     String
  easyshipRateId        String
  easyshipCourierName   String
  brandedCourierName    String
  currency              String         @default("USD")
  baseCostCents         Int
  markupCents           Int
  markupPercentUsed     Float?
  customerTotalCents    Int
  finalCustomerTotalCents Int?
  estimatedMinDays      Int?
  estimatedMaxDays      Int?
  referenceNumber       String?
  pickupRequired        Boolean        @default(false)
  easyshipOriginAddressId String?
  pickupSlotId          String?
  pickupDate            String?
  pickupFromTime        String?
  pickupToTime          String?
  pickupTimezone        String?
  pickupPriceCents      Int?
  pickupBaseCostCents   Int?
  pickupCustomerCents   Int            @default(0)
  pickupCurrency        String?
  easyshipPickupId      String?
  pickupStatus          String         @default("NONE")
  pickupErrorCode       String?
  pickupErrorMessage    String?
  labelGeneratedAt      DateTime?
  businessDate          String?
  createdBy             String?
  stripePaymentIntentId String?
  status                ShipmentStatus @default(QUOTED)
  easyshipShipmentId    String?
  labelUrl              String?
  trackingNumber        String?
  fulfillmentAttempts   Int            @default(0)
  lastError             String?
  labelEmailSentAt      DateTime?
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([stripePaymentIntentId])
  @@index([easyshipShipmentId])
  @@index([quoteGroupId])
  @@index([status, updatedAt])
  @@index([trackingNumber])
  @@index([customerEmail])
  @@index([labelGeneratedAt])
  @@index([businessDate])
  @@index([referenceNumber])
  @@index([easyshipPickupId])
  @@index([createdBy])
  @@index([pickupStatus])
}

model SavedContact {
  id            String   @id @default(cuid())
  customerEmail String
  role          String
  fingerprint   String
  label         String
  address       Json
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerEmail, role, fingerprint])
  @@index([customerEmail, role, lastUsedAt])
}

model MarkupRule {
  id                 String     @id @default(cuid())
  type               MarkupType
  value              Float
  minCents           Int?
  maxCents           Int?
  active             Boolean    @default(true)
  appliesToCourierId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model ShippingMarkupConfig {
  id               String   @id @default("default")
  enabled          Boolean  @default(true)
  percentage       Float    @default(11)
  fixedMarkupCents Int      @default(0)
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MarkupAuditLog {
  id                     String   @id @default(cuid())
  previousEnabled        Boolean?
  previousPercentage     Float?
  previousFixedMarkupCents Int?
  newEnabled             Boolean
  newPercentage          Float
  newFixedMarkupCents    Int
  changedBy              String?
  createdAt              DateTime @default(now())

  @@index([createdAt])
}

model MarkupPinAttempt {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model CourierBrandMap {
  id          String   @id @default(cuid())
  matchType   String
  matchValue  String
  displayName String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, matchType])
}

model EasyshipRecharge {
  id                   String   @id @default(cuid())
  shipmentId           String   @unique
  amountCents          Int
  status               String
  transactionReference String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, updatedAt])
}
