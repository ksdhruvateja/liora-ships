# Copy these into Netlify → Site configuration → Environment variables.
# Never commit real keys. Keep .env on your machine only.

# Neon — pooled connection (host contains -pooler). DIRECT_URL is optional;
# if omitted, Liora Labs derives it by removing "-pooler" from the host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL=

EASYSHIP_API_KEY=
EASYSHIP_BASE_URL=https://public-api.easyship.com/2024-09
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shipping markup (what you add on top of the carrier rate).
# The live markup is set in the site footer → PIN → Shipping Markup Settings
# (percentage + optional fixed $ per label). Changes apply to the next quote.
# APP_MARKUP_PERCENT only sets the starting value the first time the app runs;
# after that, use the PIN panel — changing this variable does nothing.
APP_MARKUP_PERCENT=11
# PIN that unlocks the markup panel (or set MARKUP_ADMIN_PIN_HASH instead).
MARKUP_ADMIN_PIN=

NEXT_PUBLIC_APP_NAME="Liora Labs Shipping"
# After Netlify deploy, the live HTTPS URL is picked up automatically from Netlify's URL.
# You can still set this locally. Do not put localhost in Netlify.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Label emails from this Gmail. Add GMAIL_APP_PASSWORD in Netlify, not in git.
GMAIL_USER=zippyyycare@gmail.com
GMAIL_APP_PASSWORD=
LABEL_NOTIFY_EMAIL=zippyyycare@gmail.com
ALERT_EMAIL=zippyyycare@gmail.com
SLACK_WEBHOOK_URL=
CRON_SECRET=
FOREZSHIPS_MOCK=false

# Label cancellation. Customers can cancel an unused label online for this many days after purchase
# (0 = online cancellation off; staff can still cancel from the Labels dashboard).
CANCEL_WINDOW_DAYS=30
# Fee kept from cancellation refunds, in cents (0 = full refund). Shown automatically in the refund policy.
CANCELLATION_FEE_CENTS=0

# Business details shown in the Terms, Privacy and Refund policies.
LEGAL_BUSINESS_NAME="Liora Labs Shipping"
SUPPORT_EMAIL=zippyyycare@gmail.com
# US state whose law governs the Terms, e.g. Delaware
LEGAL_GOVERNING_STATE=
LEGAL_MAILING_ADDRESS=
